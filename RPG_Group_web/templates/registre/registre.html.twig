{% extends 'base.html.twig' %}

{% block title %}Tower Of Destiny — Register{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Cinzel:wght@400;600;900&display=swap"
    rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/registre.css') }}">
{% endblock %}

{% block body %}

<!-- Particules flottantes -->
<div class="particles" aria-hidden="true">
    <div class="particle" style="--x:3%;  --dur:9s;  --delay:0s;"></div>
    <div class="particle" style="--x:10%; --dur:12s; --delay:1.5s;"></div>
    <div class="particle" style="--x:18%; --dur:8s;  --delay:3s;"></div>
    <div class="particle" style="--x:27%; --dur:14s; --delay:0.5s;"></div>
    <div class="particle" style="--x:38%; --dur:7s;  --delay:4s;"></div>
    <div class="particle" style="--x:50%; --dur:11s; --delay:2s;"></div>
    <div class="particle" style="--x:61%; --dur:9s;  --delay:1s;"></div>
    <div class="particle" style="--x:72%; --dur:13s; --delay:5s;"></div>
    <div class="particle" style="--x:83%; --dur:8s;  --delay:2.5s;"></div>
    <div class="particle" style="--x:94%; --dur:10s; --delay:3.5s;"></div>
</div>

<div class="register-card">

    <!-- Logo -->
    <div class="register-logo">
        <span class="shield-icon">🛡️</span>
        <h1>Join the<br>Tower</h1>
        <p class="tagline">Forge your legend, hero</p>
    </div>

    <div class="divider"><span>✦</span></div>

    <!-- Erreurs Symfony -->
    {% if app.user %}
    <div class="alert-rpg alert-info">⚔ You are already registered, hero!</div>
    {% endif %}

    <!-- Formulaire Symfony -->
    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'class': 'register-form'}}) }}

    <!-- Username -->
    <div class="form-group">
        <label for="registration_form_username">⚔ Hero Name</label>
        <div class="input-wrap">
            <span class="input-icon">👤</span>
            {{ form_widget(registrationForm.username, {
            'attr': {
            'placeholder': 'LegendaryHero42',
            'autocomplete': 'username',
            'class': 'rpg-input'
            }
            }) }}
            <div class="focus-bar"></div>
        </div>
        <div class="field-error">
            {{ form_errors(registrationForm.username) }}
        </div>
    </div>

    <!-- Email -->
    <div class="form-group">
        <label for="registration_form_email">📧 Email</label>
        <div class="input-wrap">
            <span class="input-icon">✉</span>
            {{ form_widget(registrationForm.email, {
            'attr': {
            'placeholder': 'hero@destiny.com',
            'autocomplete': 'email',
            'class': 'rpg-input'
            }
            }) }}
            <div class="focus-bar"></div>
        </div>
        <div class="field-error">
            {{ form_errors(registrationForm.email) }}
        </div>
    </div>

    <!-- Password -->
    <div class="form-group">
        <label for="registration_form_plainPassword_first">🔒 Password</label>
        <div class="input-wrap">
            <span class="input-icon">🗝</span>
            {{ form_widget(registrationForm.plainPassword.first, {
            'attr': {
            'placeholder': '••••••••••',
            'autocomplete': 'new-password',
            'class': 'rpg-input',
            'id': 'password1'
            }
            }) }}
            <button type="button" class="toggle-pw" data-target="password1">👁</button>
            <div class="focus-bar"></div>
        </div>
        <!-- Jauge de force — à placer dans le form-group du premier password -->
        <div class="strength-wrap">
            <div class="strength-bar">
                <div class="strength-fill" id="strengthFill"></div>
            </div>
            <span class="strength-label" id="strengthLabel"></span>
        </div>
        <div class="field-error">
            {{ form_errors(registrationForm.plainPassword.first) }}
        </div>
    </div>

    <!-- Confirm Password -->
    <div class="form-group">
        <label for="registration_form_plainPassword_second">🔒 Confirm Password</label>
        <div class="input-wrap">
            <span class="input-icon">🗝</span>
            {{ form_widget(registrationForm.plainPassword.second, {
            'attr': {
            'placeholder': '••••••••••',
            'autocomplete': 'new-password',
            'class': 'rpg-input',
            'id': 'password2'
            }
            }) }}
            <button type="button" class="toggle-pw" data-target="password2">👁</button>
            <div class="focus-bar"></div>
        </div>
        <div class="field-error">
            {{ form_errors(registrationForm.plainPassword.second) }}
        </div>
    </div>

    <!-- CGU -->
    <div class="form-group form-check-group">
        <label class="check-label">
            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'rpg-checkbox'}}) }}
            <span>I accept the <a href="#" class="terms-link">Terms of the Tower</a></span>
        </label>
        <div class="field-error">
            {{ form_errors(registrationForm.agreeTerms) }}
        </div>
    </div>

    <button class="btn-register" type="submit">🛡 Begin your Quest</button>

    {{ form_end(registrationForm) }}

    <!-- Footer -->
    <div class="register-footer">
        <a href="{{ path('app_login') }}">← Already a hero? Login</a>
        <span class="footer-sep">✦</span>
        <a href="{{ path('app_forgot_password') }}" class="forgot-link">Password forgotten</a>
        <span class="footer-sep">✦</span>
        <a href="{{ path('app_rpg') }}">← Back to tower</a>
    </div>

</div>

{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {

        // ── Toggle mot de passe ──
        document.querySelectorAll('.toggle-pw').forEach(btn => {
            btn.addEventListener('click', () => {
                const target = document.getElementById(btn.dataset.target);
                if (!target) return;
                const isHidden = target.type === 'password';
                target.type = isHidden ? 'text' : 'password';
                btn.textContent = isHidden ? '🙈' : '👁';
            });
        });

        // ── Cherche le champ password peu importe l'ID généré par Symfony ──
        const pw1 = document.querySelector('input[id$="first"]');
        const pw2 = document.querySelector('input[id$="second"]');
        const fill = document.getElementById('strengthFill');
        const label = document.getElementById('strengthLabel');

        // Met à jour les data-target des boutons toggle
        if (pw1) document.querySelectorAll('.toggle-pw')[0]?.setAttribute('data-target', pw1.id);
        if (pw2) document.querySelectorAll('.toggle-pw')[1]?.setAttribute('data-target', pw2.id);

        const levels = [
            { min: 0, max: 20, color: '#c0392b', text: '⚔ Novice', width: '20%' },
            { min: 20, max: 40, color: '#e67e22', text: '⚔ Apprenti', width: '40%' },
            { min: 40, max: 60, color: '#f1c40f', text: '⚔ Guerrier', width: '60%' },
            { min: 60, max: 80, color: '#2ecc71', text: '⚔ Héros', width: '80%' },
            { min: 80, max: 101, color: '#C9A22F', text: '⚔ Légendaire', width: '100%' },
        ];

        function scorePassword(p) {
            let score = 0;
            if (!p) return 0;
            if (p.length >= 8) score += 20;
            if (p.length >= 12) score += 10;
            if (/[A-Z]/.test(p)) score += 20;
            if (/[0-9]/.test(p)) score += 20;
            if (/[^A-Za-z0-9]/.test(p)) score += 30;
            return Math.min(score, 100);
        }

        if (pw1 && fill && label) {
            pw1.addEventListener('input', () => {
                const score = scorePassword(pw1.value);
                const level = levels.find(l => score >= l.min && score < l.max)
                    ?? levels[levels.length - 1];

                fill.style.width = level.width;
                fill.style.background = level.color;
                fill.style.boxShadow = `0 0 8px ${level.color}99`;
                label.textContent = pw1.value ? level.text : '';
                label.style.color = level.color;
            });
        }

        // ── Confirmation mot de passe ──
        if (pw1 && pw2) {
            pw2.addEventListener('input', () => {
                if (!pw2.value) {
                    pw2.style.borderColor = 'rgba(201,162,47,0.2)';
                    return;
                }
                pw2.style.borderColor = pw2.value === pw1.value ? '#2ecc71' : '#c0392b';
                pw2.style.boxShadow = pw2.value === pw1.value
                    ? '0 0 0 3px rgba(46,204,113,0.15)'
                    : '0 0 0 3px rgba(192,57,43,0.15)';
            });
        }

    });
</script>
{% endblock %}